+
+namespace com.IvanMurzak.McpPlugin.Server.Tests
+{
+    [Collection("McpPlugin.Server")]
+    public sealed class RequestExecutionSafetyTests
+    {
+        private sealed class Transport
+        {
+            public readonly Mock<IHubContext<McpServerHub>> Hub = new();
+            public readonly Mock<ISingleClientProxy> Client = new();
+            public readonly Mock<IMcpConnectionStrategy> Strategy = new();
+            public readonly Mock<IDataArguments> Arguments = new();
+            public int Sends;
+            public int Cancels;
+            public Transport(Func<RequestCallTool, CancellationToken, Task<ResponseData<ResponseCallTool>>> invoke, int timeoutMs = 30)
+            {
+                var clients = new Mock<IHubClients>();
+                clients.Setup(x => x.Client(It.IsAny<string>())).Returns(Client.Object);
+                Hub.SetupGet(x => x.Clients).Returns(clients.Object);
+                Strategy.Setup(x => x.ResolveConnectionId(It.IsAny<string?>(), It.IsAny<int>())).Returns("isolated-test-client");
+                Arguments.SetupGet(x => x.PluginTimeoutMs).Returns(timeoutMs);
+                Client.Setup(x => x.InvokeCoreAsync<ResponseData<ResponseCallTool>>(It.IsAny<string>(), It.IsAny<object?[]>(), It.IsAny<CancellationToken>()))
+                    .Returns((string method, object?[] args, CancellationToken token) => { Interlocked.Increment(ref Sends); return invoke((RequestCallTool)args[0]!, token); });
+                Client.Setup(x => x.SendCoreAsync("CancelCallTool", It.IsAny<object?[]>(), It.IsAny<CancellationToken>()))
+                    .Returns(() => { Interlocked.Increment(ref Cancels); return Task.CompletedTask; });
+            }
+            public Task<ResponseData<ResponseCallTool>> Run(RequestCallTool? request = null, CancellationToken token = default) =>
+                ClientUtils.InvokeAsync<RequestCallTool, ResponseCallTool, McpServerHub>(NullLogger.Instance, Hub.Object, "RunCallTool",
+                    request ?? NewRequest(), Arguments.Object, Strategy.Object, cancellationToken: token);
+            public RemoteToolRunner Runner(IRequestTrackingService tracking) => new(NullLogger<RemoteToolRunner>.Instance, Hub.Object, Arguments.Object, tracking, Strategy.Object);
+        }
+        private static RequestCallTool NewRequest(string id = "same-id", int value = 1) => new(id, "write-tool",
+            new Dictionary<string, JsonElement> { ["value"] = JsonSerializer.SerializeToElement(value) });
+        private static Task<ResponseData<ResponseCallTool>> Success(RequestCallTool request, CancellationToken token) => Task.FromResult(ResponseCallTool.Success().Pack(request.RequestID));
+
+        [Fact]
+        public async Task DeliveredTimeout_IsUnknown_SendsOnce_AndRequestsRemoteCancellation()
+        {
+            var finish = new TaskCompletionSource<ResponseData<ResponseCallTool>>(TaskCreationOptions.RunContinuationsAsynchronously);
+            var transport = new Transport((_, _) => finish.Task);
+            var request = NewRequest();
+            var response = await transport.Run(request);
+            Assert.Equal(ResponseErrorKind.Timeout, response.ErrorKind);
+            Assert.Contains("unknown", response.Message);
+            Assert.Contains("NOT retried", response.Message);
+            Assert.NotNull(request.DeadlineUtc);
+            Assert.Equal(1, transport.Sends);
+            Assert.Equal(1, transport.Cancels);
+            transport.Strategy.Verify(x => x.ResolveConnectionId(It.IsAny<string?>(), It.IsAny<int>()), Times.Once);
+            finish.SetResult(ResponseCallTool.Success().Pack(request.RequestID));
+            Assert.Equal(1, transport.Sends);
+        }
+        [Fact]
+        public async Task DisconnectAfterDispatch_DoesNotTryAnotherEngineOrReinvoke()
+        {
+            var transport = new Transport((_, _) => Task.FromException<ResponseData<ResponseCallTool>>(new InvalidOperationException("connection lost")));
+            Assert.Equal(ResponseErrorKind.Timeout, (await transport.Run()).ErrorKind);
+            Assert.Equal(1, transport.Sends);
+            Assert.Equal(1, transport.Cancels);
+        }
+        [Fact]
+        public async Task NoClientBeforeDispatch_CanRetry_ThenSendsExactlyOnce()
+        {
+            var transport = new Transport(Success, 1000);
+            transport.Strategy.Setup(x => x.ResolveConnectionId(It.IsAny<string?>(), 0)).Returns((string?)null);
+            Assert.Equal(ResponseStatus.Success, (await transport.Run()).Status);
+            Assert.Equal(1, transport.Sends);
+            Assert.Equal(0, transport.Cancels);
+            transport.Strategy.Verify(x => x.ResolveConnectionId(It.IsAny<string?>(), 1), Times.Once);
+        }
+        [Fact]
+        public async Task CancellationBeforeDispatch_DeliversNothing()
+        {
+            using var cancellation = new CancellationTokenSource();
+            cancellation.Cancel();
+            var transport = new Transport(Success);
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() => transport.Run(token: cancellation.Token));
+            Assert.Equal(0, transport.Sends);
+        }
+        [Fact]
+        public async Task CancellationAfterDispatch_IsUnknown_AndSendsRemoteCancel()
+        {
+            using var cancellation = new CancellationTokenSource();
+            var entered = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+            var never = new TaskCompletionSource<ResponseData<ResponseCallTool>>(TaskCreationOptions.RunContinuationsAsynchronously);
+            var transport = new Transport((_, _) => { entered.SetResult(true); return never.Task; }, 5000);
+            var responseTask = transport.Run(token: cancellation.Token);
+            await entered.Task;
+            cancellation.Cancel();
+            Assert.Equal(ResponseErrorKind.Timeout, (await responseTask.WaitAsync(TimeSpan.FromSeconds(5))).ErrorKind);
+            Assert.Equal(1, transport.Sends);
+            Assert.Equal(1, transport.Cancels);
+        }
+        [Fact]
+        public async Task ServerTracker_AtomicInFlightAndCompletionSharing_RejectsCollision()
+        {
+            using var tracking = new RequestTrackingService(NullLogger<RequestTrackingService>.Instance);
+            var finish = new TaskCompletionSource<ResponseCallTool>(TaskCreationOptions.RunContinuationsAsynchronously);
+            int count = 0;
+            Task<ResponseCallTool> Run() => tracking.TrackRequestAsync("scoped-id", () => { ++count; return finish.Task; }, TimeSpan.FromMinutes(5), fingerprint: "tool+args");
+            var first = Run();
+            Assert.All(Enumerable.Range(0, 32).Select(_ => Run()), task => Assert.Same(first, task));
+            finish.SetResult(ResponseCallTool.Success());
+            Assert.Same(await first, await Run());
+            Assert.Equal(1, count);
+            Assert.Throws<InvalidOperationException>(() => { _ = tracking.TrackRequestAsync("scoped-id", () => finish.Task, TimeSpan.Zero, fingerprint: "different"); });
+        }
+        [Fact]
+        public async Task ServerTracker_PreCanceledRequestDoesNotDispatch_ButCompletedReplaySurvivesCancellation()
+        {
+            using var tracking = new RequestTrackingService(NullLogger<RequestTrackingService>.Instance);
+            using var canceled = new CancellationTokenSource();
+            canceled.Cancel();
+            int calls = 0;
+            Task<ResponseCallTool> Execute() { ++calls; return Task.FromResult(ResponseCallTool.Success()); }
+            await Assert.ThrowsAnyAsync<OperationCanceledException>(() =>
+                tracking.TrackRequestAsync("canceled-before-start", Execute, TimeSpan.FromSeconds(1), canceled.Token));
+            Assert.Equal(0, calls);
+            var result = await tracking.TrackRequestAsync("already-completed", Execute, TimeSpan.FromSeconds(1));
+            Assert.Same(result, await tracking.TrackRequestAsync("already-completed", Execute, TimeSpan.FromSeconds(1), canceled.Token));
+            Assert.Equal(1, calls);
+        }
+        [Fact]
+        public async Task ServerTracker_ProcessingNotificationCanArriveBeforeInitialResponse()
+        {
+            using var tracking = new RequestTrackingService(NullLogger<RequestTrackingService>.Instance);
+            var final = ResponseCallTool.Success().SetRequestID("opaque-scoped-id");
+            int count = 0;
+            var result = await tracking.TrackRequestAsync("opaque-scoped-id", () =>
+            {
+                ++count;
+                tracking.CompleteRequest(final);
+                return Task.FromResult(new ResponseCallTool { Status = ResponseStatus.Processing });
+            }, TimeSpan.FromSeconds(5));
+            Assert.Same(final, result);
+            Assert.Same(final, await tracking.TrackRequestAsync("opaque-scoped-id", () => { ++count; return Task.FromResult(final); }, TimeSpan.Zero));
+            Assert.Equal(1, count);
+        }
+        [Fact]
+        public async Task ServerTracker_ProcessingTimeoutRetainsUnknown_AndDoesNotReexecute()
+        {
+            using var tracking = new RequestTrackingService(NullLogger<RequestTrackingService>.Instance);
+            int count = 0;
+            Task<ResponseCallTool> Run() => tracking.TrackRequestAsync("id", () => { ++count; return Task.FromResult(new ResponseCallTool { Status = ResponseStatus.Processing }); }, TimeSpan.FromMilliseconds(10));
+            var first = await Run();
+            Assert.Equal(ResponseErrorKind.Timeout, first.ErrorKind);
+            tracking.CompleteRequest(ResponseCallTool.Success().SetRequestID("id"));
+            Assert.Same(first, await Run());
+            Assert.Equal(1, count);
+        }
+
+        [AiToolType]
+        public sealed class SharedWriteTool
+        {
+            public static TaskCompletionSource<bool> Entered = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            public static TaskCompletionSource<bool> Release = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            public static int Calls;
+            public static int Writes;
+            public static void Reset() { Entered = new(TaskCreationOptions.RunContinuationsAsynchronously); Release = new(TaskCreationOptions.RunContinuationsAsynchronously); Calls = Writes = 0; }
+            [AiTool("shared-write")]
+            public static async Task<string> Write([RequestID] string requestId = "")
+            {
+                Interlocked.Increment(ref Calls);
+                Entered.TrySetResult(true);
+                await Release.Task.WaitAsync(ToolExecutionContext.Current!.CancellationToken);
+                Interlocked.Increment(ref Writes);
+                return requestId;
+            }
+            [AiTool("system-shared-write", ToolType = McpToolType.System)]
+            public static Task<string> SystemWrite([RequestID] string requestId = "") => Write(requestId);
+        }
+        [Fact]
+        public async Task RealToolManager_ConcurrentAndCompletedRequestsExecuteOnce()
+        {
+            SharedWriteTool.Reset();
+            using var plugin = new McpPluginBuilder(new Common.Version()).WithConfig(c => c.GenerateSkillFiles = false).WithTools<SharedWriteTool>().Build(new Reflector());
+            var manager = (McpToolManager)plugin.McpManager.ToolManager!;
+            RequestCallTool Request() => new("stable", "shared-write", new Dictionary<string, JsonElement>()) { ExecutionScope = "account/session/project" };
+            var first = manager.RunCallTool(Request());
+            var duplicates = Enumerable.Range(0, 32).Select(_ => manager.RunCallTool(Request())).ToArray();
+            await SharedWriteTool.Entered.Task.WaitAsync(TimeSpan.FromSeconds(5));
+            Assert.Equal(1, SharedWriteTool.Calls);
+            SharedWriteTool.Release.SetResult(true);
+            var result = await first;
+            await Task.WhenAll(duplicates);
+            Assert.All(duplicates, task => Assert.Same(result, task.Result));
+            Assert.Same(result, await manager.RunCallTool(Request()));
+            Assert.Equal(1, SharedWriteTool.Writes);
+            Assert.Equal(1UL, manager.ToolCallsCount);
+        }
+        [Fact]
+        public async Task RealToolManager_RemoteCancelReachesToolContextBeforeSideEffects()
+        {
+            SharedWriteTool.Reset();
+            using var plugin = new McpPluginBuilder(new Common.Version()).WithConfig(c => c.GenerateSkillFiles = false).WithTools<SharedWriteTool>().Build(new Reflector());
+            var manager = (McpToolManager)plugin.McpManager.ToolManager!;
+            var request = new RequestCallTool("stable", "shared-write", new Dictionary<string, JsonElement>()) { ExecutionScope = "account/session/project" };
+            var task = manager.RunCallTool(request);
+            await SharedWriteTool.Entered.Task.WaitAsync(TimeSpan.FromSeconds(5));
+            manager.CancelCallTool(request);
+            await task.WaitAsync(TimeSpan.FromSeconds(5));
+            SharedWriteTool.Release.SetResult(true);
+            await manager.RunCallTool(request);
+            Assert.Equal(0, SharedWriteTool.Writes);
+            Assert.Equal(1, SharedWriteTool.Calls);
+        }
+        [Fact]
+        public async Task RealSystemToolManager_DeduplicatesAndCancelsWrites()
+        {
+            SharedWriteTool.Reset();
+            using var plugin = new McpPluginBuilder(new Common.Version()).WithConfig(c => c.GenerateSkillFiles = false).WithTools<SharedWriteTool>().Build(new Reflector());
+            var manager = (McpSystemToolManager)plugin.McpManager.SystemToolManager!;
+            var request = new RequestCallTool("stable", "system-shared-write", new Dictionary<string, JsonElement>()) { ExecutionScope = "account/session/project" };
+            var first = manager.RunSystemTool(request);
+            var duplicate = manager.RunSystemTool(request);
+            await SharedWriteTool.Entered.Task.WaitAsync(TimeSpan.FromSeconds(5));
+            manager.CancelCallTool(request);
+            await Task.WhenAll(first, duplicate).WaitAsync(TimeSpan.FromSeconds(5));
+            SharedWriteTool.Release.SetResult(true);
+            Assert.Same(await first, await manager.RunSystemTool(request));
+            Assert.Equal(0, SharedWriteTool.Writes);
+            Assert.Equal(1, SharedWriteTool.Calls);
+        }
+        [Fact]
+        public async Task RemoteScope_IdentitySessionAndProject_SeparateSameId_TimeoutDoesNotRetransmit()
+        {
+            using var tracking = new RequestTrackingService(NullLogger<RequestTrackingService>.Instance);
+            var scopes = new List<string>();
+            var transport = new Transport((request, token) => { scopes.Add(request.ExecutionScope); return Success(request, token); }, 1000);
+            using var runner = transport.Runner(tracking);
+            try
+            {
+                McpSessionTokenContext.CurrentToken = "test-identity-a";
+                McpSessionTokenContext.CurrentSessionId = "session-a";
+                McpSessionTokenContext.CurrentProjectPin = "project-a";
+                await runner.RunCallTool(NewRequest());
+                await runner.RunCallTool(NewRequest()); // completed response reused
+                Assert.Equal(1, transport.Sends);
+                McpSessionTokenContext.CurrentSessionId = "session-b";
+                await runner.RunCallTool(NewRequest());
+                McpSessionTokenContext.CurrentProjectPin = "project-b";
+                await runner.RunCallTool(NewRequest());
+                McpSessionTokenContext.CurrentToken = "test-identity-b";
+                await runner.RunCallTool(NewRequest());
+                Assert.Equal(4, transport.Sends);
+                Assert.Equal(4, scopes.Distinct().Count());
+                Assert.All(scopes, scope => Assert.DoesNotContain("test-identity", scope));
+            }
+            finally
+            {
+                McpSessionTokenContext.CurrentToken = null;
+                McpSessionTokenContext.CurrentSessionId = null;
+                McpSessionTokenContext.CurrentProjectPin = null;
+            }
+        }
+    }
+}
