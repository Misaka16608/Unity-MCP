+/*
+┌────────────────────────────────────────────────────────────────────────┐
+│  Author: Ivan Murzak (https://github.com/IvanMurzak)                   │
+│  Repository: GitHub (https://github.com/IvanMurzak/MCP-Plugin-dotnet)  │
+│  Copyright (c) 2025 Ivan Murzak                                        │
+│  Licensed under the Apache License, Version 2.0.                       │
+│  See the LICENSE file in the project root for more information.        │
+└────────────────────────────────────────────────────────────────────────┘
+*/
+#nullable enable
+using System;
+using System.Threading;
+
+namespace com.IvanMurzak.McpPlugin.Common.Execution
+{
+    // Flows through tool invocation and is captured explicitly by engine dispatchers.
+    public sealed class ToolExecutionContext
+    {
+        private static readonly AsyncLocal<ToolExecutionContext?> CurrentSlot = new();
+        public static ToolExecutionContext? Current { get => CurrentSlot.Value; set => CurrentSlot.Value = value; }
+        public string IdentityScope { get; }
+        public CancellationToken CancellationToken { get; }
+        public DateTimeOffset? DeadlineUtc { get; }
+        public Action? OnMainThreadStarted { get; }
+        public void MarkMainThreadStarted() => OnMainThreadStarted?.Invoke();
+        public ToolExecutionContext(string identityScope, CancellationToken cancellationToken, DateTimeOffset? deadlineUtc, Action? onMainThreadStarted = null)
+        {
+            IdentityScope = identityScope;
+            CancellationToken = cancellationToken;
+            DeadlineUtc = deadlineUtc;
+            OnMainThreadStarted = onMainThreadStarted;
+        }
+        public void ThrowIfExpired()
+        {
+            CancellationToken.ThrowIfCancellationRequested();
+            if (DeadlineUtc.HasValue && DateTimeOffset.UtcNow >= DeadlineUtc.Value)
+                throw new OperationCanceledException("Request expired before engine execution.");
+        }
+    }
+}
