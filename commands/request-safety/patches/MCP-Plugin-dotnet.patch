diff --git a/McpPlugin/src/Mcp/ToolRequestExecutor.cs b/McpPlugin/src/Mcp/ToolRequestExecutor.cs
--- /dev/null
+++ b/McpPlugin/src/Mcp/ToolRequestExecutor.cs
@@ -0,0 +1,58 @@
+/*
+┌────────────────────────────────────────────────────────────────────────┐
+│  Author: Ivan Murzak (https://github.com/IvanMurzak)                   │
+│  Repository: GitHub (https://github.com/IvanMurzak/MCP-Plugin-dotnet)  │
+│  Copyright (c) 2025 Ivan Murzak                                        │
+│  Licensed under the Apache License, Version 2.0.                       │
+│  See the LICENSE file in the project root for more information.        │
+└────────────────────────────────────────────────────────────────────────┘
+*/
+#nullable enable
+using System;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using com.IvanMurzak.McpPlugin.Common.Model;
+
+namespace com.IvanMurzak.McpPlugin
+{
+    internal sealed class ToolRequestExecutor : IDisposable
+    {
+        readonly com.IvanMurzak.McpPlugin.Common.Execution.ExecutionRegistry<ResponseData<ResponseCallTool>> _executions = new();
+        readonly string _localScope = Guid.NewGuid().ToString("N");
+        public void Cancel(RequestCallTool data) => _executions.Cancel(
+            string.IsNullOrEmpty(data.ExecutionScope) ? _localScope : data.ExecutionScope, data.RequestID);
+        public async Task<ResponseData<ResponseCallTool>> Run(RequestCallTool data, CancellationToken cancellationToken, Func<RequestCallTool, CancellationToken, Task<ResponseData<ResponseCallTool>>> execute)
+        {
+            if (data == null) return ResponseData<ResponseCallTool>.Error(Common.Consts.Guid.Zero, "Tool data is null.", ResponseErrorKind.BadRequest);
+            var scope = string.IsNullOrEmpty(data.ExecutionScope) ? _localScope : data.ExecutionScope;
+            var fingerprint = System.Text.Json.JsonSerializer.Serialize(new { data.Name, Arguments = data.Arguments?.OrderBy(x => x.Key).ToArray(), data.IdentityScope });
+            using var registration = cancellationToken.Register(() => _executions.Cancel(scope, data.RequestID));
+            try
+            {
+                return await _executions.Run(scope, data.RequestID, fingerprint, async token =>
+                {
+                    var previous = com.IvanMurzak.McpPlugin.Common.Execution.ToolExecutionContext.Current;
+                    try
+                    {
+                        com.IvanMurzak.McpPlugin.Common.Execution.ToolExecutionContext.Current = new(
+                            data.IdentityScope, token, data.DeadlineUtc, previous?.OnMainThreadStarted);
+                        com.IvanMurzak.McpPlugin.Common.Execution.ToolExecutionContext.Current.ThrowIfExpired();
+                        return await execute(data, token);
+                    }
+                    finally { com.IvanMurzak.McpPlugin.Common.Execution.ToolExecutionContext.Current = previous; }
+                });
+            }
+            catch (OperationCanceledException)
+            {
+                return ResponseData<ResponseCallTool>.Error(data.RequestID, "Request canceled or expired before execution; started work may still have side effects.", ResponseErrorKind.Timeout);
+            }
+            catch (Exception ex)
+            {
+                return ResponseData<ResponseCallTool>.Error(data.RequestID, ex.Message, ResponseErrorKind.Conflict);
+            }
+        }
+
+        public void Dispose() => _executions.Dispose();
+    }
+}
