+using com.IvanMurzak.ReflectorNet;
+using Microsoft.Extensions.DependencyInjection;
+using Xunit;
+
+namespace com.IvanMurzak.McpPlugin.Server.Tests
+{
+    [Collection("McpPlugin.Server")]
+    public sealed class RequestExecutionTransportTests
+    {
+        [AiToolType]
+        public sealed class PausedTool
+        {
+            public static TaskCompletionSource<Action> Posted = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            public static TaskCompletionSource<bool> Canceled = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            public static int Writes;
+            public static void Reset()
+            {
+                Posted = new(TaskCreationOptions.RunContinuationsAsynchronously);
+                Canceled = new(TaskCreationOptions.RunContinuationsAsynchronously);
+                Writes = 0;
+            }
+            [AiTool("paused-write")]
+            public static async Task<int> Write()
+            {
+                var context = ToolExecutionContext.Current!;
+                var result = new TaskCompletionSource<int>(TaskCreationOptions.RunContinuationsAsynchronously);
+                using var registration = context.CancellationToken.Register(() => { Canceled.TrySetResult(true); result.TrySetCanceled(); });
+                // A controllable engine boundary, with the production ambient context.
+                // The actual Unity queue algorithm is tested separately from shipped source.
+                Posted.SetResult(() =>
+                {
+                    try { context.ThrowIfExpired(); result.TrySetResult(Interlocked.Increment(ref Writes)); }
+                    catch (OperationCanceledException) { result.TrySetCanceled(); }
+                });
+                return await result.Task;
+            }
+        }
+        private static IMcpPlugin Build(string url) => new McpPluginBuilder(new Common.Version { Api = Consts.ApiVersion, Plugin = Consts.PluginVersion })
+            .WithConfig(config => { config.Host = url; config.GenerateSkillFiles = false; config.KeepConnected = false; })
+            .WithTools<PausedTool>().Build(new Reflector());
+
+        [Fact]
+        public async Task RealHttpAndSignalR_McpCancelReachesQueuedPluginInvocation()
+        {
+            PausedTool.Reset();
+            await using var host = await NoneAuthMcpHost.StartAsync(services => services.AddSingleton<IDataArguments>(
+                new DataArguments(new[] { "auth=none", "plugin-timeout=10000" })));
+            using var plugin = Build(host.BaseUrl);
+            using var connectTimeout = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+            await plugin.Connect(connectTimeout.Token);
+            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
+            var session = await host.HandshakeAsync(http);
+            var call = host.PostAsync(http, session, new { jsonrpc = "2.0", id = 45, method = "tools/call", @params = new { name = "paused-write", arguments = new { } } });
+            var queued = await PausedTool.Posted.Task.WaitAsync(TimeSpan.FromSeconds(5));
+            await host.PostAsync(http, session, new { jsonrpc = "2.0", method = "notifications/cancelled", @params = new { requestId = 45, reason = "test queued cancellation" } });
+            await PausedTool.Canceled.Task.WaitAsync(TimeSpan.FromSeconds(5));
+            queued();
+            Assert.Equal(0, PausedTool.Writes);
+            Assert.Equal(1UL, plugin.McpManager.ToolManager!.ToolCallsCount);
+            // MCP may omit the canceled response. Close this test client's pending HTTP
+            // request after observing cancellation at the real plugin execution boundary.
+            http.Dispose();
+            try { await call.WaitAsync(TimeSpan.FromSeconds(5)); }
+            catch (OperationCanceledException) { }
+            catch (HttpRequestException) { }
+        }
+
+        [Fact]
+        public async Task RealHttpAndSignalR_TimeoutSendsOnce_RecoveryDoesNotWrite()
+        {
+            PausedTool.Reset();
+            await using var host = await NoneAuthMcpHost.StartAsync(services => services.AddSingleton<IDataArguments>(
+                new DataArguments(new[] { "auth=none", "plugin-timeout=1000" })));
+            using var plugin = Build(host.BaseUrl);
+            using var connectTimeout = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+            await plugin.Connect(connectTimeout.Token);
+            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
+            var session = await host.HandshakeAsync(http);
+            var call = host.PostAsync(http, session, new { jsonrpc = "2.0", id = 46, method = "tools/call", @params = new { name = "paused-write", arguments = new { } } });
+            var queued = await PausedTool.Posted.Task.WaitAsync(TimeSpan.FromSeconds(5));
+            var (body, _) = await call.WaitAsync(TimeSpan.FromSeconds(5));
+            Assert.Contains("unknown", body);
+            Assert.Contains("NOT retried", body);
+            await PausedTool.Canceled.Task.WaitAsync(TimeSpan.FromSeconds(5));
+            var (redelivery, _) = await host.PostAsync(http, session, new { jsonrpc = "2.0", id = 46, method = "tools/call", @params = new { name = "paused-write", arguments = new { } } });
+            Assert.Contains("unknown", redelivery);
+            queued();
+            Assert.Equal(0, PausedTool.Writes);
+            Assert.Equal(1UL, plugin.McpManager.ToolManager!.ToolCallsCount);
+        }
+    }
+}
