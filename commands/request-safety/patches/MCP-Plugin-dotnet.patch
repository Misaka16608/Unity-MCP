diff --git a/McpPlugin.Common/src/Execution/ExecutionRegistry.cs b/McpPlugin.Common/src/Execution/ExecutionRegistry.cs
--- /dev/null
+++ b/McpPlugin.Common/src/Execution/ExecutionRegistry.cs
@@ -0,0 +1,97 @@
+/*
+┌────────────────────────────────────────────────────────────────────────┐
+│  Author: Ivan Murzak (https://github.com/IvanMurzak)                   │
+│  Repository: GitHub (https://github.com/IvanMurzak/MCP-Plugin-dotnet)  │
+│  Copyright (c) 2025 Ivan Murzak                                        │
+│  Licensed under the Apache License, Version 2.0.                       │
+│  See the LICENSE file in the project root for more information.        │
+└────────────────────────────────────────────────────────────────────────┘
+*/
+#nullable enable
+using System;
+using System.Collections.Generic;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace com.IvanMurzak.McpPlugin.Common.Execution
+{
+    // No timed eviction: admitting an old ID again would silently repeat its side effects.
+    // At capacity fail closed; callers must start a new session/process deliberately.
+    public sealed class ExecutionRegistry<T> : IDisposable
+    {
+        private readonly object _gate = new();
+        private readonly Dictionary<string, Entry> _entries = new(StringComparer.Ordinal);
+        private readonly int _capacity;
+        private bool _disposed;
+        public ExecutionRegistry(int capacity = 10000) { _capacity = capacity; }
+        private sealed class Entry
+        {
+            public string? Fingerprint;
+            public readonly CancellationTokenSource Cancellation = new();
+            public readonly TaskCompletionSource<T> Completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            public bool Started;
+        }
+        public Task<T> Run(string scope, string id, string fingerprint, Func<CancellationToken, Task<T>> execute)
+        {
+            if (string.IsNullOrWhiteSpace(scope) || string.IsNullOrWhiteSpace(id))
+                throw new ArgumentException("Execution scope and request ID are required.");
+            Entry entry;
+            lock (_gate)
+            {
+                if (_disposed) throw new ObjectDisposedException(nameof(ExecutionRegistry<T>));
+                var key = Key(scope, id);
+                if (!_entries.TryGetValue(key, out entry!))
+                {
+                    if (_entries.Count >= _capacity) throw new InvalidOperationException("Execution ledger is full; refusing to discard deduplication history.");
+                    _entries.Add(key, entry = new Entry());
+                }
+                if (entry.Fingerprint != null && entry.Fingerprint != fingerprint)
+                    throw new InvalidOperationException("Request ID already belongs to a different tool or arguments.");
+                entry.Fingerprint = fingerprint;
+                if (entry.Started) return entry.Completion.Task;
+                entry.Started = true;
+            }
+            // Do not run a synchronous tool on the SignalR receive loop: cancellation must
+            // remain receivable while the engine waits for its main thread.
+            _ = Task.Run(async () =>
+            {
+                try
+                {
+                    entry.Cancellation.Token.ThrowIfCancellationRequested();
+                    entry.Completion.TrySetResult(await execute(entry.Cancellation.Token).ConfigureAwait(false));
+                }
+                catch (OperationCanceledException) { entry.Completion.TrySetCanceled(); }
+                catch (Exception ex) { entry.Completion.TrySetException(ex); }
+            });
+            return entry.Completion.Task;
+        }
+        public void Cancel(string scope, string id)
+        {
+            Entry entry;
+            lock (_gate)
+            {
+                if (_disposed) return;
+                var key = Key(scope, id);
+                if (!_entries.TryGetValue(key, out entry!))
+                {
+                    if (_entries.Count >= _capacity) throw new InvalidOperationException("Execution ledger is full.");
+                    _entries.Add(key, entry = new Entry()); // tombstone for cancel-before-delivery
+                }
+            }
+            entry.Cancellation.Cancel();
+        }
+        private static string Key(string scope, string id) => scope.Length + ":" + scope + id;
+        public void Dispose()
+        {
+            Entry[] entries;
+            lock (_gate)
+            {
+                if (_disposed) return;
+                _disposed = true;
+                entries = new List<Entry>(_entries.Values).ToArray();
+            }
+            foreach (var entry in entries) entry.Cancellation.Cancel();
+            // Tokens can still be used by non-interruptible work; do not dispose them early.
+        }
+    }
+}
