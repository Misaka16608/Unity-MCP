<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- HTTP is confined to loopback. The proxy uses verified HTTPS upstream. -->
    <add key="node-tls-nuget" value="http://127.0.0.1:18763/v3/index.json" allowInsecureConnections="true" />
  </packageSources>
</configuration>
